#include<stdio.h>
int main(){
    int n,i,j,found;
    int min=10;
    int max=50;
    for(i=min;i<max;i++){
        int found=0;
        for(j=2;j<i;j++){
            if(i%j==0){
                found=1;
                break;
        }
    }
    if(found==0){
    printf("%d is a prime number\n",i);
    }

    else if(found==1){
        printf("%d is not a prime number\n",i);
    }
}}
